pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'prod'], description: 'Target environment')
        choice(name: 'ACTION', choices: ['deploy', 'destroy', 'status'], description: 'Action to perform')
    }

    environment {
        DOCKER_REGISTRY = 'localhost:5000' 
    }

    stages {

        stage('Validate Environment') {
            steps {
                script {
                    if (params.ENVIRONMENT == 'prod' && params.ACTION == 'deploy') {
                        input message: '¿Desplegar INFRAESTRUCTURA a PRODUCCIÓN? Esta acción es crítica.', ok: 'Sí, desplegar'
                    }
                    if (params.ENVIRONMENT == 'prod' && params.ACTION == 'destroy') {
                        error('No se permite destruir el entorno de producción')
                    }
                }
                sh """
                    echo "Target environment: ${params.ENVIRONMENT}"
                    echo "Action: ${params.ACTION}"
                    kubectl version --client
                """
            }
        }

        stage('Check Status') {
            when { expression { params.ACTION == 'status' } }
            steps {
                sh """
                    echo "Infrastructure status for ${params.ENVIRONMENT}:"
                    kubectl get pods -n ${params.ENVIRONMENT} 2>/dev/null || echo "Namespace not found"
                    kubectl get services -n ${params.ENVIRONMENT} 2>/dev/null || echo "No services found"
                    kubectl get pvc -n ${params.ENVIRONMENT} 2>/dev/null || echo "No PVCs found"
                """
            }
        }

        stage('Destroy Infrastructure') {
            when { 
                expression { 
                    params.ACTION == 'destroy' && params.ENVIRONMENT in ['dev', 'stage']
                }
            }
            steps {
                input message: "¿Destruir infraestructura en ${params.ENVIRONMENT}? Se perderán todos los datos.", ok: 'Sí, destruir'
                sh """
                    echo "Destroying infrastructure in ${params.ENVIRONMENT}..."
                    kubectl delete namespace ${params.ENVIRONMENT} --ignore-not-found
                    echo "Infrastructure destroyed"
                """
            }
        }

        stage('Create Namespace') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh """
                    kubectl create namespace ${params.ENVIRONMENT} --dry-run=client -o yaml | kubectl apply -f -
                """
            }
        }

        stage('Apply Secrets') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh """
                    echo "Applying secrets for ${params.ENVIRONMENT}..."
                    kubectl apply -f k8s/${params.ENVIRONMENT}/secrets.yaml
                """
            }
        }

        stage('Deploy Infrastructure') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh """
                    echo "Deploying infrastructure components..."
                    kubectl apply -f k8s/${params.ENVIRONMENT}/infrastructure/ || true
                """
            }
        }

        stage('Wait for Deployments') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh """
                    echo "Waiting for deployments to be ready..."
                    sleep 10
                    kubectl rollout status deployment/postgres -n ${params.ENVIRONMENT} --timeout=180s || true
                    kubectl rollout status deployment/neo4j -n ${params.ENVIRONMENT} --timeout=180s || true
                    kubectl rollout status deployment/zookeeper -n ${params.ENVIRONMENT} --timeout=120s || true
                    kubectl rollout status deployment/kafka -n ${params.ENVIRONMENT} --timeout=180s || true
                    kubectl rollout status deployment/redis -n ${params.ENVIRONMENT} --timeout=60s || true
                    kubectl rollout status deployment/openldap -n ${params.ENVIRONMENT} --timeout=120s || true
                """
            }
        }

        stage('Validate Infrastructure') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh """
                    echo "Validating all infrastructure pods..."
                    kubectl get pods -n ${params.ENVIRONMENT}
                """
            }
        }

        stage('Create Kafka Topics') {
            when { expression { params.ACTION == 'deploy' && params.ENVIRONMENT != 'prod' } }
            steps {
                sh """
                    echo "Waiting for Kafka to be ready..."
                    sleep 20
                    
                    echo "Creating Kafka topics..."
                    KAFKA_POD=\$(kubectl get pod -n ${params.ENVIRONMENT} -l app=kafka -o jsonpath="{.items[0].metadata.name}")
                    if [ -n "\$KAFKA_POD" ]; then
                        kubectl exec -n ${params.ENVIRONMENT} \$KAFKA_POD -- \
                            kafka-topics --create --if-not-exists \
                            --topic promotion.status.changed \
                            --bootstrap-server localhost:9092 \
                            --partitions 3 --replication-factor 1 || true
                        
                        kubectl exec -n ${params.ENVIRONMENT} \$KAFKA_POD -- \
                            kafka-topics --create --if-not-exists \
                            --topic audit.identity.accessed \
                            --bootstrap-server localhost:9092 \
                            --partitions 3 --replication-factor 1 || true
                        
                        echo "Existing topics:"
                        kubectl exec -n ${params.ENVIRONMENT} \$KAFKA_POD -- \
                            kafka-topics --list --bootstrap-server localhost:9092
                    else
                        echo "Kafka pod not found, topics will be created later"
                    fi
                """
            }
        }
    }

    post {
        success {
            echo """
            ============================================
            Infrastructure ${params.ACTION} completed!
            
            Environment: ${params.ENVIRONMENT}
            Action: ${params.ACTION}
            
            Next steps:
              kubectl get pods -n ${params.ENVIRONMENT}
              kubectl get services -n ${params.ENVIRONMENT}
            ============================================
            """
        }
        failure {
            echo "Infrastructure ${params.ACTION} failed for environment: ${params.ENVIRONMENT}"
            sh "kubectl get pods -n ${params.ENVIRONMENT} 2>/dev/null || true"
        }
        always { cleanWs() }
    }
}