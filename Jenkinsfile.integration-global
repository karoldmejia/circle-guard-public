pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    environment {
        NAMESPACE = "integration-test-${BUILD_NUMBER}"
    }
    
    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Create Namespace') {
            when { branch 'develop' }
            steps {
                sh "kubectl create ns ${NAMESPACE} || true"
            }
        }

        stage('Apply Secrets') {
            when { branch 'develop' }
            steps {
                sh "kubectl apply -f k8s/dev/secrets-no-namespace.yaml -n ${NAMESPACE}"
            }
        }

        stage('Deploy infrastructure') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying infrastructure to namespace ${NAMESPACE}..."
                    
                    # Deploy infrastructure
                    for file in postgres.yaml openldap.yaml redis.yaml neo4j.yaml zookeeper.yaml kafka.yaml mailhog.yaml; do
                        echo "Processing \$file"
                        grep -v "namespace: dev" k8s/dev/infrastructure/\$file | kubectl apply -f - -n ${NAMESPACE}
                    done
                    
                    echo "Waiting for PostgreSQL..."
                    kubectl wait --for=condition=ready pod -l app=postgres -n ${NAMESPACE} --timeout=180s
                    
                    echo "Waiting for Neo4j..."
                    kubectl wait --for=condition=ready pod -l app=neo4j -n ${NAMESPACE} --timeout=300s
                    
                    echo "Waiting for Zookeeper..."
                    kubectl wait --for=condition=ready pod -l app=zookeeper -n ${NAMESPACE} --timeout=180s
                    
                    echo "Waiting for Kafka..."
                    kubectl wait --for=condition=ready pod -l app=kafka -n ${NAMESPACE} --timeout=300s

                    echo "Waiting for MailHog..."
                    kubectl wait --for=condition=ready pod -l app=mailhog -n ${NAMESPACE} --timeout=180s
                    
                    echo "Infrastructure ready"
                    kubectl get pods -n ${NAMESPACE}
                """
            }
        }

        stage('Create Databases') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Creating databases in PostgreSQL..."
                    
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_identity;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_auth;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_promotion;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_dashboard;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_form;" || true
                    
                    echo "Databases created successfully"
                """
            }
        }

        stage('Deploy Identity') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying Identity service..."
                    grep -v "namespace: dev" k8s/dev/services/identity.yaml | kubectl apply -f - -n ${NAMESPACE}
                    kubectl rollout status deployment/identity-service -n ${NAMESPACE} --timeout=300s
                """
            }
        }

        stage('Deploy Auth') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying Auth service..."
                    grep -v "namespace: dev" k8s/dev/services/auth.yaml | kubectl apply -f - -n ${NAMESPACE}
                    kubectl set env deployment/auth-service -n ${NAMESPACE} SPRING_LDAP_ENABLED=false
                    kubectl set env deployment/auth-service -n ${NAMESPACE} MANAGEMENT_HEALTH_LDAP_ENABLED=false
                    kubectl rollout status deployment/auth-service -n ${NAMESPACE} --timeout=300s
                """
            }
        }

        stage('Deploy Promotion (Lightweight)') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying Promotion service with reduced resources..."
                    
                    grep -v "namespace: dev" k8s/dev/services/promotion.yaml | kubectl apply -f - -n ${NAMESPACE}

                    kubectl rollout status deployment/promotion-service -n ${NAMESPACE} --timeout=600s
                """
            }
        }

        stage('Deploy Remaining Services') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying Gateway, Dashboard, Notification..."
                    
                    for service in gateway dashboard notification; do
                        echo "Deploying \$service..."
                        grep -v "namespace: dev" k8s/dev/services/\$service.yaml | kubectl apply -f - -n ${NAMESPACE}
                    done
                    
                    kubectl rollout status deployment/gateway-service -n ${NAMESPACE} --timeout=300s
                    kubectl rollout status deployment/dashboard-service -n ${NAMESPACE} --timeout=300s
                    kubectl rollout status deployment/notification-service -n ${NAMESPACE} --timeout=300s
                """
            }
        }

        stage('Smoke Tests') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "=== Health Checks ==="
                    
                    kubectl exec -n ${NAMESPACE} deployment/identity-service -- wget -qO- http://localhost:8083/actuator/health | grep UP && echo "identity: OK" || echo "identity: FAIL"
                    kubectl exec -n ${NAMESPACE} deployment/auth-service -- wget -qO- http://localhost:8180/actuator/health | grep UP && echo "auth: OK" || echo "auth: FAIL"
                    kubectl exec -n ${NAMESPACE} deployment/promotion-service -- wget -qO- http://localhost:8088/actuator/health | grep UP && echo "promotion: OK" || echo "promotion: FAIL"
                    
                    echo "=== Smoke Tests Completed ==="
                """
            }
        }

        stage('Deploy to STAGE (if release branch)') {
            when { branch 'release/*' }
            steps {
                sh """                    
                    echo "Creating stage namespace if not exists..."
                    kubectl create namespace stage --dry-run=client -o yaml | kubectl apply -f -
                    
                    echo "Deploying to STAGE namespace..."
                    
                    # Aplicar secrets a stage
                    kubectl apply -f k8s/dev/secrets-no-namespace.yaml -n stage || true
                    
                    # Desplegar infraestructura a stage
                    for file in k8s/dev/infrastructure/*.yaml; do
                        echo "Processing \$file"
                        grep -v "namespace: dev" \$file | kubectl apply -f - -n stage || true
                    done
                    
                    echo "Waiting for PostgreSQL to be ready..."
                    kubectl wait --for=condition=ready pod -l app=postgres -n stage --timeout=180s
                    
                    echo "Waiting for Redis..."
                    kubectl wait --for=condition=ready pod -l app=redis -n stage --timeout=180s
                    
                    # Crear bases de datos
                    echo "Creating databases..."
                    kubectl exec -n stage deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_identity;" || true
                    kubectl exec -n stage deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_auth;" || true
                    kubectl exec -n stage deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_promotion;" || true
                    kubectl exec -n stage deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_dashboard;" || true
                    
                    # Desplegar servicios a stage
                    for service in identity auth promotion gateway dashboard notification; do
                        echo "Deploying \$service..."
                        grep -v "namespace: dev" k8s/dev/services/\${service}.yaml | kubectl apply -f - -n stage
                    done
                    
                    # Esperar a que los servicios críticos estén listos (SIN || true)
                    echo "Waiting for Identity..."
                    kubectl rollout status deployment/identity-service -n stage --timeout=300s
                    
                    echo "Waiting for Auth..."
                    kubectl rollout status deployment/auth-service -n stage --timeout=300s
                    
                    echo "Waiting for Gateway..."
                    kubectl rollout status deployment/gateway-service -n stage --timeout=300s
                    
                    echo "Waiting for Dashboard..."
                    kubectl rollout status deployment/dashboard-service -n stage --timeout=300s
                    
                    echo "Waiting for Notification..."
                    kubectl rollout status deployment/notification-service -n stage --timeout=300s
                    
                    echo "Waiting for Promotion..."
                    kubectl rollout status deployment/promotion-service -n stage --timeout=600s
                    
                    echo "Stage environment ready"
                    
                    # Trigger E2E pipeline
                    build job: 'circle-guard-e2e-stage', wait: false, propagate: false
                """
            }
        }
    }

    post {
        always {
            sh "kubectl delete ns ${NAMESPACE} || true"
            cleanWs()
        }
    }
}