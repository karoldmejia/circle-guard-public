pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    environment {
        NAMESPACE = "integration-test-${BUILD_NUMBER}"
    }
    
    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Create Namespace') {
            when { branch 'develop' }
            steps {
                sh """
                kubectl create ns ${NAMESPACE} || true
                apply_to_namespace() {
                            local file=\$1
                            local ns=\$2
                            grep -v "namespace:" "\$file" | kubectl apply -f - -n "\$ns"
                        }
                """
                
            }
        }

        stage('Apply Secrets') {
            when { branch 'develop' }
            steps {
                sh """
                    kubectl apply -f k8s/dev/secrets-no-namespace.yaml -n ${NAMESPACE}
                """
            }
        }

        stage('Deploy Infrastructure') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying infrastructure to namespace ${NAMESPACE}..."
                    
                    # Crear directorio temporal
                    mkdir -p /tmp/infra-${NAMESPACE}
                    
                    # Copiar archivos y eliminar la línea 'namespace: dev'
                    for file in k8s/dev/infrastructure/*.yaml; do
                        echo "Processing \$file"
                        # Eliminar la línea que contiene 'namespace: dev'
                        grep -v "namespace: dev" \$file > /tmp/infra-${NAMESPACE}/\$(basename \$file)
                    done
                    
                    # Aplicar los archivos limpios
                    kubectl apply -f /tmp/infra-${NAMESPACE}/ -n ${NAMESPACE}
                    
                    echo "Waiting for infrastructure to be ready..."
                    sleep 60
                    kubectl get pods -n ${NAMESPACE}
                    
                    # Limpiar
                    rm -rf /tmp/infra-${NAMESPACE}
                """
            }
        }

        stage('Create databases') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Creating databases in PostgreSQL..."
                    
                    # Esperar a que PostgreSQL esté listo
                    kubectl wait --for=condition=ready pod -l app=postgres -n ${NAMESPACE} --timeout=120s
                    
                    # Crear bases de datos necesarias
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_identity;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_auth;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_promotion;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_dashboard;" || true
                    kubectl exec -n ${NAMESPACE} deployment/postgres -- psql -U admin -d postgres -c "CREATE DATABASE circleguard_form;" || true
                    
                    echo "Databases created successfully"
                """
            }
        }

        stage('Deploy Identity') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "Deploying Identity service to namespace ${NAMESPACE}..."
                    
                    # Crear directorio temporal para servicios
                    mkdir -p /tmp/services-${NAMESPACE}
                    
                    # Copiar y limpiar archivo de identity
                    grep -v "namespace: dev" k8s/dev/services/identity.yaml > /tmp/services-${NAMESPACE}/identity.yaml
                    
                    # Aplicar
                    kubectl apply -f /tmp/services-${NAMESPACE}/identity.yaml -n ${NAMESPACE}
                    kubectl rollout status deployment/identity-service -n ${NAMESPACE} --timeout=300s
                    
                    # Limpiar
                    rm -rf /tmp/services-${NAMESPACE}
                """
            }
        }

        stage('Deploy Auth + Promotion') {
            when { branch 'develop' }
            parallel {
                stage('Auth') {
                    steps {
                        sh """
                        echo "Deploying Auth service to namespace ${NAMESPACE}..."
                        
                        # Función para aplicar YAML sin namespace fijo
                        apply_to_namespace() {
                            local file=\$1
                            local ns=\$2
                            grep -v "namespace:" "\$file" | kubectl apply -f - -n "\$ns"
                        }
                        
                        apply_to_namespace k8s/dev/services/auth.yaml ${NAMESPACE}
                        
                        # Deshabilitar LDAP
                        kubectl set env deployment/auth-service -n ${NAMESPACE} SPRING_LDAP_ENABLED=false
                        kubectl set env deployment/auth-service -n ${NAMESPACE} MANAGEMENT_HEALTH_LDAP_ENABLED=false
                        
                        kubectl rollout status deployment/auth-service -n ${NAMESPACE} --timeout=300s
                        """
                    }
                }
                stage('Promotion') {
                    steps {
                        sh """
                            echo "Deploying Promotion service to namespace ${NAMESPACE}..."
                            
                            apply_to_namespace k8s/dev/services/promotion.yaml ${NAMESPACE}

                            # Esperar a que promotion esté listo
                            kubectl rollout status deployment/promotion-service -n ${NAMESPACE} --timeout=300s
                        """
                    }
                }
            }
        }

        stage('Deploy Remaining Services') {
            when { branch 'develop' }
            parallel {
                stage('Gateway') {
                    steps {
                        sh """
                            mkdir -p /tmp/services-${NAMESPACE}
                            grep -v "namespace: dev" k8s/dev/services/gateway.yaml > /tmp/services-${NAMESPACE}/gateway.yaml
                            kubectl apply -f /tmp/services-${NAMESPACE}/gateway.yaml -n ${NAMESPACE}
                            kubectl rollout status deployment/gateway-service -n ${NAMESPACE} --timeout=300s
                            rm -rf /tmp/services-${NAMESPACE}
                        """
                    }
                }
                stage('Dashboard') {
                    steps {
                        sh """
                            mkdir -p /tmp/services-${NAMESPACE}
                            grep -v "namespace: dev" k8s/dev/services/dashboard.yaml > /tmp/services-${NAMESPACE}/dashboard.yaml
                            kubectl apply -f /tmp/services-${NAMESPACE}/dashboard.yaml -n ${NAMESPACE}
                            kubectl rollout status deployment/dashboard-service -n ${NAMESPACE} --timeout=300s
                            rm -rf /tmp/services-${NAMESPACE}
                        """
                    }
                }
                stage('Notification') {
                    steps {
                        sh """
                            mkdir -p /tmp/services-${NAMESPACE}
                            grep -v "namespace: dev" k8s/dev/services/notification.yaml > /tmp/services-${NAMESPACE}/notification.yaml
                            kubectl apply -f /tmp/services-${NAMESPACE}/notification.yaml -n ${NAMESPACE}
                            kubectl rollout status deployment/notification-service -n ${NAMESPACE} --timeout=300s
                            rm -rf /tmp/services-${NAMESPACE}
                        """
                    }
                }
            }
        }

        stage('Smoke Tests') {
            when { branch 'develop' }
            steps {
                sh """
                    echo "=== Health Checks via kubectl exec ==="
                    
                    # Identity
                    kubectl exec -n ${NAMESPACE} deployment/identity-service -- \
                        wget -qO- http://localhost:8083/actuator/health | grep UP && echo "identity: OK" || echo "identity: FAIL"
                    
                    # Auth
                    kubectl exec -n ${NAMESPACE} deployment/auth-service -- \
                        wget -qO- http://localhost:8300/actuator/health | grep UP && echo "auth: OK" || echo "auth: FAIL"
                    
                    # Promotion
                    kubectl exec -n ${NAMESPACE} deployment/promotion-service -- \
                        wget -qO- http://localhost:8088/actuator/health | grep UP && echo "promotion: OK" || echo "promotion: FAIL"
                    
                    echo "=== Smoke Tests Passed ==="
                """
            }
        }
    }

    post {
        always {
            sh "kubectl delete ns ${NAMESPACE} || true"
            cleanWs()
        }
    }
}