pipeline {
    agent any

    environment {
        SERVICE         = 'circleguard-notification-service'
        SERVICE_DIR     = "services/${SERVICE}"
        IMAGE_NAME      = "circleguard/notification-service"
        PORT            = '8082'
        DOCKER_REGISTRY = 'localhost:5000'
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Compile & Package') {
            steps {
                dir(env.SERVICE_DIR) {
                    script {
                        env.APP_VERSION = sh(script: "grep '^version' ../../build.gradle.kts | head -1 | sed \"s/version = '//;s/'//\"", returnStdout: true).trim()
                    }
                    sh './gradlew clean bootJar --no-daemon'
                }
            }
        }

        stage('Build & Publish Docker Image') {
            steps {
                dir(env.SERVICE_DIR) {
                    sh "docker build -t ${IMAGE_NAME}:${APP_VERSION} -f Dockerfile ."
                    sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${IMAGE_NAME}:${APP_VERSION} || true"
                    sh "docker push ${DOCKER_REGISTRY}/${IMAGE_NAME}:${APP_VERSION}"
                }
            }
        }

        stage('Unit Tests') {
            when { branch 'develop' }
            steps {
                dir(env.SERVICE_DIR) {
                    sh './gradlew test --no-daemon'
                }
            }
            post {
                always { junit "${env.SERVICE_DIR}/build/test-results/test/*.xml" }
            }
        }

        stage('Integration Tests (Kafka + GreenMail + WireMock)') {
            when { branch 'develop' }
            steps {
                dir(env.SERVICE_DIR) {
                    sh './gradlew integrationTest --no-daemon -Dspring.profiles.active=integration'
                }
            }
            post {
                always { junit "${env.SERVICE_DIR}/build/test-results/integrationTest/*.xml" }
            }
        }

        // ── DEPLOY (ELIMINADO: docker exec no funciona en K8s) ──
        stage('Deploy to DEV') {
            when { branch 'develop' }
            steps {
                sh '''
                    kubectl apply -f k8s/dev/services/notification.yaml
                    kubectl rollout status deployment/notification-service -n dev --timeout=300s
                    kubectl logs -l app=notification-service -n dev --tail=10 | grep "subscribed" || echo "Check Kafka subscription"
                '''
            }
        }

        stage('Deploy to STAGE') {
            when { branch 'release/*' }
            steps {
                input message: '¿Desplegar Notification a STAGE?', ok: 'Desplegar'
                sh 'kubectl apply -f k8s/stage/services/notification.yaml'
                sh 'kubectl rollout status deployment/notification-service -n stage --timeout=180s'
            }
        }

        stage('Deploy to PROD') {
            when { branch 'main' }
            steps {
                input message: ' ¿Desplegar Notification a PROD?', ok: 'Sí'
                sh '''
                    kubectl apply -f k8s/prod/services/notification.yaml
                    kubectl rollout status deployment/notification-service -n prod --timeout=300s
                '''
            }
        }

        stage('Release') {
            when { branch 'main' }
            steps {
                sh '''
                    git tag -a "notification-v${APP_VERSION}" -m "Notification service release ${APP_VERSION}"
                    git push origin "notification-v${APP_VERSION}"
                '''
            }
        }
    }

    post {
        failure {
            script {
                if (env.BRANCH_NAME == 'main') {
                    sh 'kubectl rollout undo deployment/notification-service -n prod || true'
                }
            }
        }
        always { cleanWs() }
    }
}