pipeline {
    agent any

    environment {
        SERVICE        = 'circleguard-identity-service'
        SERVICE_DIR    = "services/${SERVICE}"
        IMAGE_NAME     = "circleguard/identity-service"
        PORT           = '8083'
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Compile & Package') {
            steps {
                sh "./gradlew :services:${SERVICE}:clean :services:${SERVICE}:bootJar --no-daemon"
            }
        }

        stage('Extract Version') {
            steps {
                script {
                    env.APP_VERSION = sh(
                        script: "grep 'version =' build.gradle.kts | head -1 | sed 's/.*version = //; s/\"//g; s/\\x27//g' | tr -d ' '",
                        returnStdout: true
                    ).trim()
                    echo "Version extracted: ${env.APP_VERSION}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir(env.SERVICE_DIR) {
                    sh "docker build -t ${IMAGE_NAME}:${APP_VERSION} -f Dockerfile ."
                }
            }
        }

        stage('Security Scan (Trivy)') {
            steps {
                sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${IMAGE_NAME}:${APP_VERSION} || true"
            }
        }

        stage('Scan for Hardcoded Secrets') {
            steps {
                dir(env.SERVICE_DIR) {
                    sh '''
                        if grep -r "vault.secret\\s*=\\s*['\\\"][^$]" src/main/; then
                            echo "ERROR: Hardcoded vault secret detected!"
                            exit 1
                        fi
                        echo "Secret scan passed."
                    '''
                }
            }
        }

        // TESTS 
        stage('Unit Tests') {
            when { branch 'develop' }
            steps {
                sh "./gradlew :services:${SERVICE}:test --no-daemon --refresh-dependencies"
            }
            post {
                always {
                    junit "${SERVICE_DIR}/build/test-results/test/*.xml"
                }
            }
        }

        stage('Integration Tests') {
            when { branch 'develop' }
            steps {
                sh "./gradlew :services:${SERVICE}:integrationTest --no-daemon --refresh-dependencies"
            }
            post {
                always {
                    junit "${SERVICE_DIR}/build/test-results/integrationTest/*.xml"
                }
            }
        }

        // DEPLOY 
        stage('Deploy to DEV') {
            when { branch 'develop' }
            steps {
                sh '''
                    echo "Cleaning old pods..."
                    kubectl delete pods -n dev -l app=identity-service --force --grace-period=0 || true

                    echo "Applying secrets..."
                    kubectl apply -f k8s/dev/secrets.yaml

                    echo "Applying deployment..."
                    kubectl apply -f k8s/dev/services/identity.yaml

                    echo "Waiting rollout..."
                    kubectl rollout status deployment/identity-service -n dev --timeout=180s

                    echo "Checking health..."
                    kubectl exec -n dev deployment/identity-service -- \
                    curl -sf http://localhost:8083/actuator/health | grep UP

                    echo "Deployment successful"
                '''
            }
            post {
                failure {
                    sh '''
                        echo "=== PODS ==="
                        kubectl get pods -n dev

                        echo "=== DESCRIBE ==="
                        kubectl describe deployment identity-service -n dev || true

                        echo "=== LOGS ==="
                        kubectl logs -n dev deployment/identity-service || true
                    '''
                }
            }
        }

        stage('Deploy to STAGE') {
            when { branch 'release/*' }
            steps {
                input message: '¿Desplegar Identity a STAGE?', ok: 'Desplegar'

                sh '''
                    kubectl delete pods -n stage -l app=identity-service --force --grace-period=0 || true

                    kubectl apply -f k8s/stage/services/identity.yaml

                    kubectl rollout status deployment/identity-service -n stage --timeout=240s
                '''
            }
        }

        stage('Deploy to PROD') {
            when { branch 'main' }
            steps {
                input message: '¿Desplegar Identity a PRODUCCIÓN?', ok: 'Sí'

                sh '''
                    kubectl apply -f k8s/prod/services/identity.yaml

                    kubectl rollout status deployment/identity-service -n prod --timeout=300s
                '''
            }
        }

        // RELEASE 
        stage('Release') {
            when { branch 'main' }
            steps {
                sh '''
                    git tag -a "identity-v${APP_VERSION}" -m "Identity service release ${APP_VERSION}"
                    git push origin "identity-v${APP_VERSION}"
                    echo "Release ${APP_VERSION} completed!"
                '''
            }
        }
    }

    post {
        failure {
            echo "Pipeline failed for ${env.SERVICE}"
            script {
                if (env.BRANCH_NAME == 'main') {
                    sh 'kubectl rollout undo deployment/identity-service -n prod || true'
                }
            }
        }
        always {
            cleanWs()
        }
    }
}