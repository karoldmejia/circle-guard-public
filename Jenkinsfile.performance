pipeline {
    agent none

    stages {

        stage('Check stage') {
            agent any
            steps {
                sh "kubectl get pods -n stage"
            }
        }

        stage('Run tests') {
            agent {
                docker {
                    image 'locustio/locust'
                }
            }

            steps {
                sh """
                    cd performance
                    locust -f locustfile.py \
                        --host=http://gateway-service.stage.svc.cluster.local:8087 \
                        --users=100 \
                        --spawn-rate=10 \
                        --run-time=120s \
                        --headless
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}