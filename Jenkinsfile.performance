pipeline {
    agent any

    parameters {
        choice(name: 'TEST_TYPE', choices: ['gateway', 'login', 'dashboard', 'propagation', 'mixed'])
        string(name: 'USERS', defaultValue: '100')
        string(name: 'SPAWN_RATE', defaultValue: '10')
        string(name: 'RUN_TIME', defaultValue: '120')
    }

    stages {

        stage('Check stage') {
            steps {
                sh "kubectl get pods -n stage"
            }
        }

        stage('Run tests') {
            steps {
                sh """
                    cd performance
                    
                    # Port-forwards
                    kubectl port-forward -n stage service/gateway-service 8087:8087 > /dev/null 2>&1 &
                    kubectl port-forward -n stage service/auth-service 8180:8180 > /dev/null 2>&1 &
                    kubectl port-forward -n stage service/dashboard-service 8084:8084 > /dev/null 2>&1 &
                    kubectl port-forward -n stage service/promotion-service 8088:8088 > /dev/null 2>&1 &
                    
                    sleep 10
                    
                    locust -f locustfile.py \
                        --host=http://localhost:8087 \
                        --users=${USERS} \
                        --spawn-rate=${SPAWN_RATE} \
                        --run-time=${RUN_TIME}s \
                        --headless \
                        --only-summary
                    
                    kill %1 %2 %3 %4 2>/dev/null || true
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'performance/*.html, performance/*.csv', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}